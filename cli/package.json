{
  "name": "@rootwatch/cli",
  "version": "0.1.0",
  "description": "RootWatch CLI — dev security control panel: auth, posture, scans, local project scanner, MCP bridge",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/homezloco/rootwatch.git",
    "directory": "cli"
  },
  "homepage": "https://rootwatch.dev",
  "bugs": "https://github.com/homezloco/rootwatch/issues",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rootwatch": "dist/index.js",
    "rw": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
